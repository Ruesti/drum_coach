    },
    {
      "id": "demo_kit_v1",
      "ms": 2505,
      "text": "Next up: add the bass drum on the and of three.",
      "hash": "44055f349f53ba4f"
    },
    {
      "id": "demo_kit_v2",
      "ms": 3703,
      "text": "Now add a soft ghost note on the snare, on the e of two.",
      "hash": "7a64fce2b2d67981"
    },
    {
      "id": "demo_kit_v3",
      "ms": 2537,
      "text": "Last one: open the hi-hat on the and of four.",
      "hash": "b15967d6dfe83e09"
    },
    {
      "id": "demo_pad_v1",
      "ms": 2838,
      "text": "Next up: accent the first note of every beat.",
      "hash": "3e1ef1dbbcc3dadc"
    },
    {
      "id": "demo_pad_v2",
      "ms": 2704,
      "text": "Now switch to doubles: right right, left left.",
      "hash": "d1c3eab2c931fd01"
    },
    {
      "id": "demo_pad_v3",
      "ms": 5259,
      "text": "Last one: play paradiddles. Right left right right, left right left left.",
